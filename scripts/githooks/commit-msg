#!/bin/sh
set -eu

msg_file="${1:-}"
if [ -z "$msg_file" ] || [ ! -f "$msg_file" ]; then
  echo "commit-msg: missing commit message file argument" >&2
  exit 1
fi

subject="$(head -n 1 "$msg_file" | tr -d '\r')"

if [ -z "$subject" ]; then
  echo "commit-msg: blocked (empty commit message)" >&2
  exit 1
fi

case "$subject" in
  Merge\ *) exit 0 ;;
  Revert\ *) exit 0 ;;
esac

echo "$subject" | grep -q ':' || {
  echo "commit-msg: blocked (missing ':' in subject)." >&2
  echo "commit-msg: expected format: <milestone>: <what> <why>" >&2
  exit 1
}

len="$(printf "%s" "$subject" | wc -c | tr -d ' ')"
if [ "$len" -lt 12 ]; then
  echo "commit-msg: blocked (subject too short)." >&2
  echo "commit-msg: expected format: <milestone>: <what> <why>" >&2
  exit 1
fi

exit 0

